<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cafepos.controllers.DashboardController" spacing="12">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label text="Dashboard" styleClass="title"/>
    <Label fx:id="salesLabel" text="Ventes du jour: 0,00 DZD" styleClass="subtitle"/>
    <Label fx:id="ordersLabel" text="Nombre de commandes: 0" styleClass="subtitle"/>
</VBox>
