<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane fx:id="rootStack" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.cafepos.controllers.StockController">
    <VBox spacing="0">
        <HBox fx:id="toolbar" alignment="CENTER_LEFT" spacing="8">
            <padding>
                <Insets top="8" right="12" bottom="8" left="12"/>
            </padding>
            <StackPane HBox.hgrow="ALWAYS">
                <TextField fx:id="searchField" promptText="Rechercher… F7" style="-fx-padding: 0 0 0 28px;"/>
                <FontIcon iconLiteral="mdi2m-magnify" iconSize="16" iconColor="#6B2D1A"
                          StackPane.alignment="CENTER_LEFT">
                    <StackPane.margin>
                        <Insets top="0" right="0" bottom="0" left="8"/>
                    </StackPane.margin>
                </FontIcon>
            </StackPane>
            <Button fx:id="newProductButton" onAction="#onNewProduct" styleClass="action-button">
                <graphic>
                    <HBox spacing="6" alignment="CENTER">
                        <FontIcon iconLiteral="mdi2p-plus" iconSize="16" iconColor="#6B2D1A"/>
                        <Label text="Nouveau"/>
                    </HBox>
                </graphic>
            </Button>
            <Button fx:id="linkIngredientButton" onAction="#onLinkIngredient" styleClass="ghost-button">
                <graphic>
                    <HBox spacing="6" alignment="CENTER">
                        <FontIcon iconLiteral="mdi2l-link-variant" iconSize="16" iconColor="#1A4A6B"/>
                        <Label text="Lier ingrédient"/>
                    </HBox>
                </graphic>
            </Button>
        </HBox>

        <TabPane fx:id="tabPane" VBox.vgrow="ALWAYS">
            <tabs>
                <Tab text="Produits" closable="false">
                    <content>
                        <TableView fx:id="productsTable" fixedCellSize="52" VBox.vgrow="ALWAYS" editable="true">
                            <columns>
                                <TableColumn fx:id="activeColumn" text="" prefWidth="40"/>
                                <TableColumn fx:id="nameColumn" text="Nom" prefWidth="200"/>
                                <TableColumn fx:id="categoryColumn" text="Catégorie" prefWidth="140"/>
                                <TableColumn fx:id="preparedColumn" text="Préparé" prefWidth="90"/>
                                <TableColumn fx:id="priceColumn" text="Prix" prefWidth="100"/>
                                <TableColumn fx:id="costColumn" text="Coût" prefWidth="100"/>
                                <TableColumn fx:id="stockColumn" text="Stock" prefWidth="160"/>
                            </columns>
                        </TableView>
                    </content>
                </Tab>
                <Tab text="Ingredients" closable="false">
                    <content>
                        <VBox spacing="10">
                            <padding>
                                <Insets top="12" right="12" bottom="12" left="12"/>
                            </padding>
                            <FlowPane hgap="8" vgap="8" prefWrapLength="1200" alignment="CENTER_LEFT">
                                <Button fx:id="newIngredientButton" text="+ Ingredient" onAction="#onNewIngredient" styleClass="action-button ingredient-toolbar-button"/>
                                <Button fx:id="purchaseIngredientButton" text="Achat / Reappro" onAction="#onPurchaseIngredient" styleClass="ghost-button ingredient-toolbar-button"/>
                                <Button fx:id="withdrawShoppingButton" text="Sortie caisse shopping" onAction="#onWithdrawShoppingCash" styleClass="ghost-button ingredient-toolbar-button"/>
                                <Button fx:id="editIngredientButton" text="Editer" onAction="#onEditIngredient" styleClass="ghost-button ingredient-toolbar-button"/>
                                <Button fx:id="deleteIngredientButton" text="Supprimer" onAction="#onDeleteIngredient" styleClass="ghost-button ingredient-toolbar-button"/>
                                <Button fx:id="activateIngredientButton" text="Activer" onAction="#onActivateIngredient" styleClass="ghost-button ingredient-toolbar-button"/>
                                <Button fx:id="deactivateIngredientButton" text="Desactiver" onAction="#onDeactivateIngredient" styleClass="ghost-button ingredient-toolbar-button"/>
                                <Button fx:id="manageUnitsButton" text="Gérer unités" onAction="#onManageUnits" styleClass="ghost-button ingredient-toolbar-button"/>
                            </FlowPane>
                            <Label text="Double-cliquez ou utilisez Editer pour modifier un ingrédient" styleClass="hint-label" wrapText="true"/>
                            <TableView fx:id="ingredientsTable" editable="false" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="ingredientActiveColumn" text="Actif" prefWidth="52"/>
                                    <TableColumn fx:id="ingredientNameColumn" text="Ingrédient" prefWidth="190"/>
                                    <TableColumn fx:id="ingredientUnitColumn" text="Unité" prefWidth="80"/>
                                    <TableColumn fx:id="ingredientStockColumn" text="Stock total" prefWidth="110"/>
                                    <TableColumn fx:id="ingredientPacksColumn" text="Stock (packs)" prefWidth="110"/>
                                    <TableColumn fx:id="ingredientMinColumn" text="Seuil alerte" prefWidth="100"/>
                                    <TableColumn fx:id="ingredientPackageSizeColumn" text="Contenance / pack" prefWidth="130"/>
                                    <TableColumn fx:id="ingredientPackagePriceColumn" text="Prix achat (pack)" prefWidth="130"/>
                                    <TableColumn fx:id="ingredientUnitCostColumn" text="Coût / unité" prefWidth="110"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </content>
                </Tab>
                <Tab text="Recettes" closable="false">
                    <content>
                        <VBox spacing="10">
                            <padding>
                                <Insets top="12" right="12" bottom="12" left="12"/>
                            </padding>
                            <FlowPane hgap="8" vgap="8" prefWrapLength="1200" alignment="CENTER_LEFT">
                                <Label text="Produit:"/>
                                <ComboBox fx:id="recipeProductCombo" prefWidth="280" onAction="#onRecipeProductChanged"/>
                                <Label fx:id="recipeEstimatedCostLabel" text="Cout recette: 0 DZD" styleClass="hint-label"/>
                            </FlowPane>
                            <TableView fx:id="recipeTable" editable="true" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="recipeIngredientColumn" text="Ingredient" prefWidth="220"/>
                                    <TableColumn fx:id="recipeUnitColumn" text="Unite" prefWidth="80"/>
                                    <TableColumn fx:id="recipeQuantityColumn" text="Qte / boisson" prefWidth="120"/>
                                    <TableColumn fx:id="recipeUnitCostColumn" text="Cout unite" prefWidth="110"/>
                                    <TableColumn fx:id="recipeLineCostColumn" text="Cout ligne" prefWidth="110"/>
                                </columns>
                            </TableView>
                            <FlowPane hgap="8" vgap="8" prefWrapLength="1200" alignment="CENTER_LEFT">
                                <ComboBox fx:id="recipeIngredientCombo" prefWidth="240" promptText="Ingredient"/>
                                <TextField fx:id="recipeQuantityField" prefWidth="120" promptText="Quantite"/>
                                <ComboBox fx:id="recipeUnitCombo" prefWidth="90" promptText="Unite"/>
                                <Button text="Ajouter / MAJ" styleClass="action-button ingredient-toolbar-button" onAction="#onAddRecipeLine"/>
                                <Button text="Supprimer" styleClass="ghost-button ingredient-toolbar-button" onAction="#onRemoveRecipeLine"/>
                            </FlowPane>
                        </VBox>
                    </content>
                </Tab>
                <Tab text="Suppléments" closable="false">
                    <content>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="card-scroll">
                            <content>
                                <VBox fx:id="supplementsBox" spacing="12">
                                    <padding>
                                        <Insets top="12" right="12" bottom="12" left="12"/>
                                    </padding>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>
                <Tab text="Catégories" closable="false">
                    <content>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="card-scroll">
                            <content>
                                <VBox fx:id="categoriesBox" spacing="8">
                                    <padding>
                                        <Insets top="12" right="12" bottom="12" left="12"/>
                                    </padding>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </VBox>

        <VBox fx:id="toastContainer" spacing="8" mouseTransparent="true" pickOnBounds="false"
            StackPane.alignment="BOTTOM_RIGHT">
        <StackPane.margin>
            <Insets top="0" right="12" bottom="12" left="0"/>
        </StackPane.margin>
    </VBox>
</StackPane>
