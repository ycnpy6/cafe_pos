<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cafepos.controllers.ReportsController" spacing="12">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label text="Rapports" styleClass="title"/>
    <HBox spacing="10">
        <Label text="Du" styleClass="subtitle"/>
        <DatePicker fx:id="startDatePicker"/>
        <Label text="Au" styleClass="subtitle"/>
        <DatePicker fx:id="endDatePicker"/>
        <Button text="Charger" onAction="#onLoad" styleClass="action-button"/>
        <Button text="Exporter CSV" onAction="#onExport" styleClass="action-button"/>
    </HBox>
    <Label fx:id="summaryLabel" text="Total: 0,00 DZD" styleClass="subtitle"/>
    <TableView fx:id="reportTable" prefHeight="320">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="70"/>
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="200"/>
            <TableColumn fx:id="paymentColumn" text="Paiement" prefWidth="120"/>
            <TableColumn fx:id="totalColumn" text="Total" prefWidth="120"/>
        </columns>
    </TableView>
</VBox>
