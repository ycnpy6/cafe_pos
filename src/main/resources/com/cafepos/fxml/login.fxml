<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cafepos.controllers.LoginController">
    <top>
        <VBox alignment="CENTER" spacing="4" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="18" right="18" bottom="8" left="18"/>
            </padding>
            <Label text="Cafe POS" styleClass="title"/>
            <Label text="Connexion" styleClass="subtitle"/>
        </VBox>
    </top>
    <center>
        <HBox alignment="CENTER" spacing="24" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="8" right="24" bottom="24" left="24"/>
            </padding>
            <VBox alignment="CENTER_LEFT" spacing="12">
                <Label text="Code PIN" styleClass="subtitle"/>
                <PasswordField fx:id="pinField" promptText="PIN" editable="false" styleClass="pin-field"/>
                <GridPane hgap="8" vgap="8">
                    <Button text="1" onAction="#onDigit" styleClass="keypad-button" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Button text="2" onAction="#onDigit" styleClass="keypad-button" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Button text="3" onAction="#onDigit" styleClass="keypad-button" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                    <Button text="4" onAction="#onDigit" styleClass="keypad-button" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Button text="5" onAction="#onDigit" styleClass="keypad-button" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Button text="6" onAction="#onDigit" styleClass="keypad-button" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                    <Button text="7" onAction="#onDigit" styleClass="keypad-button" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Button text="8" onAction="#onDigit" styleClass="keypad-button" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Button text="9" onAction="#onDigit" styleClass="keypad-button" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                    <Button text="Effacer" onAction="#onClear" styleClass="keypad-button" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <Button text="0" onAction="#onDigit" styleClass="keypad-button" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    <Button onAction="#onBackspace" styleClass="keypad-button" GridPane.rowIndex="3" GridPane.columnIndex="2">
                        <graphic>
                            <HBox spacing="6" alignment="CENTER">
                                <FontIcon iconLiteral="mdi2a-arrow-left" iconSize="16" iconColor="#6B2D1A"/>
                                <Label text="Retour"/>
                            </HBox>
                        </graphic>
                    </Button>
                </GridPane>
                <Button fx:id="loginButton" text="Se connecter" onAction="#onLogin" maxWidth="Infinity" styleClass="action-button"/>
                <Label fx:id="statusLabel" text="" styleClass="status-label"/>
            </VBox>
            <VBox alignment="TOP_LEFT" spacing="10">
                <fx:define>
                    <ToggleGroup fx:id="roleGroup"/>
                </fx:define>
                <Label text="Role" styleClass="subtitle"/>
                <ToggleButton text="Manager" toggleGroup="$roleGroup" userData="MANAGER"/>
                <ToggleButton text="Barista" toggleGroup="$roleGroup" userData="BARISTA" selected="true"/>
                <Label text="Utilisateur" styleClass="subtitle"/>
                <ComboBox fx:id="userCombo" prefWidth="240" promptText="Choisir un utilisateur"/>
                <Label text="Barista: PIN optionnel. Manager: PIN requis." styleClass="hint-label" wrapText="true"/>
                <Label text="Acces local uniquement" styleClass="hint-label"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
