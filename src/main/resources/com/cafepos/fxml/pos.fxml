<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootStack" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.cafepos.controller.POSController">
    <BorderPane fx:id="posRoot" prefWidth="1280" prefHeight="800">
        <top>
            <HBox fx:id="topBar" prefHeight="40" spacing="12" alignment="CENTER_LEFT" styleClass="bg-subtle"
                  style="-fx-padding: 0 12px; -fx-border-color: -color-border-default; -fx-border-width: 0 0 1 0;">
                <Label fx:id="lblAppName" text="%app.name" styleClass="text-bold" style="-fx-font-size: 14px;" HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblSessionInfo" styleClass="text-muted" style="-fx-font-size: 12px;"/>
                <Button fx:id="btnHome" text="🏠" prefWidth="36" prefHeight="36" styleClass="button flat" onAction="#onHomeClicked">
                    <tooltip>
                        <Tooltip text="%home.tooltip"/>
                    </tooltip>
                </Button>
            </HBox>
        </top>

        <center>
            <HBox fx:id="mainArea">
                <ScrollPane fx:id="productScrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            HBox.hgrow="ALWAYS" styleClass="edge-to-edge">
                    <content>
                        <FlowPane fx:id="productGrid" hgap="8" vgap="8" style="-fx-padding: 10px;"/>
                    </content>
                </ScrollPane>

                <VBox fx:id="categoryTabsBar" prefWidth="72" minWidth="72" maxWidth="72"
                      styleClass="bg-subtle"
                      style="-fx-border-color: -color-border-default; -fx-border-width: 0 1 0 1;">
                    <VBox fx:id="categoryTabsContainer" VBox.vgrow="ALWAYS" spacing="0"/>
                </VBox>

                <VBox fx:id="orderPanel" prefWidth="260" minWidth="260" maxWidth="260"
                      style="-fx-border-color: -color-border-default; -fx-border-width: 0 1 0 0;">
                    <HBox fx:id="rfidCard" prefHeight="52" spacing="10" alignment="CENTER_LEFT"
                          visible="false" managed="false"
                          style="-fx-padding: 8px 12px; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-border-width: 2px;">
                        <Label fx:id="rfidIcon" text="👤" style="-fx-font-size: 18px;"/>
                        <VBox fx:id="rfidInfo" spacing="2" HBox.hgrow="ALWAYS">
                            <Label fx:id="rfidName" styleClass="text-bold" style="-fx-font-size: 14px;"/>
                            <Label fx:id="rfidBalance" styleClass="text-muted" style="-fx-font-size: 12px;"/>
                        </VBox>
                        <Button fx:id="btnDetachRfid" text="×" prefWidth="32" prefHeight="32" styleClass="button flat" onAction="#onDetachCustomer"/>
                    </HBox>

                    <ScrollPane fx:id="orderScrollPane" VBox.vgrow="ALWAYS" fitToWidth="true" hbarPolicy="NEVER"
                                vbarPolicy="AS_NEEDED" styleClass="edge-to-edge">
                        <content>
                            <VBox fx:id="orderLinesContainer" spacing="4" style="-fx-padding: 8px;">
                                <Label fx:id="emptyOrderLabel" text="Aucun article" styleClass="text-muted"
                                       style="-fx-padding: 12px; -fx-alignment: center;" maxWidth="Infinity"/>
                            </VBox>
                        </content>
                    </ScrollPane>

                    <HBox fx:id="discountRow" prefHeight="28" spacing="8" alignment="CENTER"
                          visible="false" managed="false"
                          style="-fx-padding: 0 12px; -fx-border-color: -color-border-default; -fx-border-width: 1 0 0 0;">
                        <Label text="Remise:" styleClass="text-muted" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblDiscount" text="-0 DZD" styleClass="warning"/>
                    </HBox>

                    <HBox fx:id="tvaRow" prefHeight="28" spacing="8" alignment="CENTER"
                          visible="false" managed="false"
                          style="-fx-padding: 0 12px; -fx-border-color: -color-border-default; -fx-border-width: 1 0 0 0;">
                        <Label fx:id="lblTvaTitle" text="TVA:" styleClass="text-muted" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblTva" text="0 DZD" styleClass="text-muted"/>
                    </HBox>

                    <HBox fx:id="totalRow" prefHeight="48" spacing="8" alignment="CENTER" styleClass="bg-subtle"
                          style="-fx-padding: 0 16px; -fx-border-color: -color-border-default; -fx-border-width: 1 0 0 0;">
                        <Label text="TOTAL" styleClass="text-muted" style="-fx-font-size: 14px;" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblTotal" styleClass="text-bold" style="-fx-font-size: 24px;"/>
                        <Label text=" DZD" styleClass="text-muted" style="-fx-font-size: 14px;"/>
                    </HBox>

                    <HBox fx:id="paymentButtons" prefHeight="64" spacing="6" style="-fx-padding: 6px;">
                        <Button fx:id="btnCash" text="Espèces&#10;F11" prefHeight="60" styleClass="button success"
                                style="-fx-font-size: 14px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                onAction="#onPayCash"/>
                        <Button fx:id="btnPrepaid" text="Prépayé&#10;F12" prefHeight="60" styleClass="button accent"
                                style="-fx-font-size: 14px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                disable="true" onAction="#onPayPrepaid"/>
                    </HBox>
                </VBox>

                    <VBox fx:id="rightColumn" prefWidth="236" minWidth="236" maxWidth="236"
                      style="-fx-border-color: -color-border-default; -fx-border-width: 0 0 0 1;">
                    <FlowPane fx:id="operationBar" hgap="4" vgap="4" styleClass="bg-subtle"
                              style="-fx-padding: 6px; -fx-border-color: -color-border-default; -fx-border-width: 0 0 1 0;">
                        <Button fx:id="btnNewOrder" prefWidth="52" prefHeight="58" styleClass="button elevated" onAction="#onNewOrder">
                            <graphic>
                                <VBox alignment="CENTER" spacing="1">
                                    <Label text="＋" style="-fx-font-size: 18px;"/>
                                    <Label text="Nouvelle" style="-fx-font-size: 10px;"/>
                                    <Label text="F6" styleClass="text-muted" style="-fx-font-size: 9px;"/>
                                </VBox>
                            </graphic>
                        </Button>
                        <Button fx:id="btnDiscount" prefWidth="52" prefHeight="58" styleClass="button accent" onAction="#onDiscount">
                            <graphic>
                                <VBox alignment="CENTER" spacing="1">
                                    <Label text="\%" style="-fx-font-size: 18px;"/>
                                    <Label text="Remise" style="-fx-font-size: 10px;"/>
                                    <Label text="F7" styleClass="text-muted" style="-fx-font-size: 9px;"/>
                                </VBox>
                            </graphic>
                        </Button>
                        <Button fx:id="btnHold" prefWidth="52" prefHeight="58" styleClass="button warning" onAction="#onHoldOrder">
                            <graphic>
                                <VBox alignment="CENTER" spacing="1">
                                    <Label text="⏸" style="-fx-font-size: 18px;"/>
                                    <Label text="Attente" style="-fx-font-size: 10px;"/>
                                    <Label text="Hold" styleClass="text-muted" style="-fx-font-size: 9px;"/>
                                </VBox>
                            </graphic>
                        </Button>
                        <Button fx:id="btnWaiting" prefWidth="52" prefHeight="58" styleClass="button elevated" onAction="#onWaitingOrders">
                            <graphic>
                                <StackPane>
                                    <VBox alignment="CENTER" spacing="1">
                                        <Label text="🗂" style="-fx-font-size: 18px;"/>
                                        <Label text="Liste" style="-fx-font-size: 10px;"/>
                                        <Label text="Files" styleClass="text-muted" style="-fx-font-size: 9px;"/>
                                    </VBox>
                                    <Label fx:id="waitingCountBadge" text="0" styleClass="warning"
                                           visible="false" managed="false" StackPane.alignment="TOP_RIGHT"/>
                                </StackPane>
                            </graphic>
                        </Button>
                        <Button fx:id="btnReprint" prefWidth="52" prefHeight="58" styleClass="button elevated" onAction="#onReprint">
                            <graphic>
                                <VBox alignment="CENTER" spacing="1">
                                    <Label text="🖨" style="-fx-font-size: 18px;"/>
                                    <Label text="Réimpr." style="-fx-font-size: 10px;"/>
                                    <Label text="F8" styleClass="text-muted" style="-fx-font-size: 9px;"/>
                                </VBox>
                            </graphic>
                        </Button>
                        <Button fx:id="btnRefund" prefWidth="52" prefHeight="58" styleClass="button warning" onAction="#onRefund">
                            <graphic>
                                <VBox alignment="CENTER" spacing="1">
                                    <Label text="↩" style="-fx-font-size: 18px;"/>
                                    <Label text="Remb." style="-fx-font-size: 10px;"/>
                                    <Label text="F10" styleClass="text-muted" style="-fx-font-size: 9px;"/>
                                </VBox>
                            </graphic>
                        </Button>
                        <Button fx:id="btnHistory" prefWidth="52" prefHeight="58" styleClass="button elevated" onAction="#onHistory">
                            <graphic>
                                <VBox alignment="CENTER" spacing="1">
                                    <Label text="📋" style="-fx-font-size: 18px;"/>
                                    <Label text="Histor." style="-fx-font-size: 10px;"/>
                                    <Label text="F11" styleClass="text-muted" style="-fx-font-size: 9px;"/>
                                </VBox>
                            </graphic>
                        </Button>
                        <Button fx:id="btnTopup" prefWidth="52" prefHeight="58" styleClass="button success" onAction="#onTopup">
                            <graphic>
                                <VBox alignment="CENTER" spacing="1">
                                    <Label text="💳" style="-fx-font-size: 18px;"/>
                                    <Label text="Recharge" style="-fx-font-size: 10px;"/>
                                    <Label text="F9" styleClass="text-muted" style="-fx-font-size: 9px;"/>
                                </VBox>
                            </graphic>
                        </Button>
                    </FlowPane>

                    <VBox fx:id="numpadArea" VBox.vgrow="ALWAYS" spacing="4" style="-fx-padding: 6px; -fx-alignment: center;">
                        <Label text="Sélectionnez un article" styleClass="text-muted"/>
                    </VBox>

                    <HBox fx:id="statusRow" prefHeight="26" alignment="CENTER_LEFT" styleClass="bg-subtle"
                          style="-fx-padding: 0 8px; -fx-border-color: -color-border-default; -fx-border-width: 1 0 0 0;">
                        <Label fx:id="lblPrintQueue" styleClass="text-muted" style="-fx-font-size: 11px;"
                               visible="false" managed="false"/>
                    </HBox>
                </VBox>
            </HBox>
        </center>

        <bottom>
            <HBox fx:id="statusBar" prefHeight="26" spacing="12" alignment="CENTER_LEFT" styleClass="bg-subtle"
                  style="-fx-padding: 0 12px; -fx-border-color: -color-border-default; -fx-border-width: 1 0 0 0;">
                <Label fx:id="lblWorkPeriod" text="%status.workperiod" styleClass="text-muted" style="-fx-font-size: 12px;" HBox.hgrow="ALWAYS"/>
                <Label fx:id="printBadge" styleClass="warning" style="-fx-font-size: 11px;" visible="false" managed="false"/>
            </HBox>
        </bottom>
    </BorderPane>

    <TextField fx:id="rfidField" opacity="0" prefWidth="1" prefHeight="1" focusTraversable="true"/>

    <StackPane fx:id="supplementOverlay" visible="false" managed="false" styleClass="overlay-backdrop">
        <VBox fx:id="supplementPanel" prefWidth="460" maxWidth="460" spacing="12" styleClass="popup-card">
            <Label fx:id="supplementTitle" styleClass="title-4" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
            <Separator/>
            <ScrollPane fx:id="supplementScrollPane" VBox.vgrow="ALWAYS" fitToWidth="true" hbarPolicy="NEVER" prefHeight="300">
                <content>
                    <VBox fx:id="supplementGroupsContainer" spacing="16" style="-fx-padding: 4px;"/>
                </content>
            </ScrollPane>
            <HBox spacing="8">
                <Button fx:id="btnSupplementCancel" text="%supplement.cancel" styleClass="button elevated"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="52" onAction="#onSupplementCancel"/>
                <Button fx:id="btnSupplementAdd" text="%supplement.add" styleClass="button success"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="52" onAction="#onSupplementAdd"/>
            </HBox>
        </VBox>
    </StackPane>

    <VBox fx:id="historyPanel" visible="false" managed="false" prefWidth="380" spacing="10" styleClass="popup-card"
          StackPane.alignment="CENTER_RIGHT">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="📋 Historique du jour" styleClass="title-4" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Fermer" styleClass="button flat" onAction="#onHistoryClose"/>
        </HBox>
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER" styleClass="edge-to-edge">
            <content>
                <VBox fx:id="historyRowsBox" spacing="6" style="-fx-padding: 4px;"/>
            </content>
        </ScrollPane>
    </VBox>

    <VBox fx:id="waitingPanel" visible="false" managed="false" prefWidth="380" spacing="10" styleClass="popup-card"
          StackPane.alignment="CENTER_RIGHT">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="🗂 Commandes en attente" styleClass="title-4" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Fermer" styleClass="button flat" onAction="#onWaitingClose"/>
        </HBox>
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER" styleClass="edge-to-edge">
            <content>
                <VBox fx:id="waitingRowsBox" spacing="6" style="-fx-padding: 4px;"/>
            </content>
        </ScrollPane>
    </VBox>

    <VBox fx:id="topupDialog" visible="false" managed="false" prefWidth="420" spacing="12" styleClass="popup-card"
          StackPane.alignment="CENTER">
        <Label text="💳 Recharger la carte" styleClass="title-4" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
        <Label fx:id="topupCustomerLabel" text="" styleClass="text-bold" style="-fx-font-size: 14px;"/>
        <Label fx:id="topupBalanceLabel" text="" styleClass="text-muted" style="-fx-font-size: 12px;"/>
        <Separator/>
        <Label text="Montant recharge" styleClass="text-muted" style="-fx-font-size: 12px;"/>
        <TextField fx:id="topupAmountInput" style="-fx-font-size: 28px; -fx-alignment: center-right;"/>
        <HBox spacing="8">
            <Button text="200" userData="200" styleClass="button elevated" onAction="#onTopupQuick" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button text="500" userData="500" styleClass="button elevated" onAction="#onTopupQuick" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button text="1000" userData="1000" styleClass="button elevated" onAction="#onTopupQuick" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button text="2000" userData="2000" styleClass="button elevated" onAction="#onTopupQuick" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        </HBox>
        <Label fx:id="topupAfterLabel" text="" styleClass="text-muted" style="-fx-font-size: 12px;"/>
        <HBox spacing="8">
            <Button text="%cancel" styleClass="button elevated" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="52"
                    onAction="#onTopupCancel"/>
            <Button text="✓ %confirm" styleClass="button success" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="52"
                    onAction="#onTopupConfirm"/>
        </HBox>
    </VBox>

    <VBox fx:id="refundDialog" visible="false" managed="false" prefWidth="700" maxWidth="700" spacing="10"
          styleClass="popup-card" StackPane.alignment="CENTER">
        <Label text="↩ Remboursement" styleClass="title-4" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
        <HBox spacing="8">
            <TextField fx:id="refundSearchField" promptText="Rechercher commande (ID, date, client)"
                       onAction="#onRefundSearch" HBox.hgrow="ALWAYS"/>
            <Button text="Rechercher" styleClass="button elevated" onAction="#onRefundSearch"/>
        </HBox>
        <ScrollPane fitToWidth="true" prefHeight="160" hbarPolicy="NEVER" styleClass="edge-to-edge">
            <content>
                <VBox fx:id="refundOrdersBox" spacing="6" style="-fx-padding: 4px;"/>
            </content>
        </ScrollPane>
        <Separator/>
        <Label fx:id="refundSelectedOrderLabel" text="Aucune commande selectionnee" styleClass="text-muted"/>
        <ScrollPane fitToWidth="true" prefHeight="140" hbarPolicy="NEVER" styleClass="edge-to-edge">
            <content>
                <VBox fx:id="refundLinesBox" spacing="6" style="-fx-padding: 4px;"/>
            </content>
        </ScrollPane>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Montant rembourse:" styleClass="text-muted"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="refundTotalLabel" text="0 DZD" styleClass="text-bold" style="-fx-font-size: 16px;"/>
        </HBox>
        <CheckBox fx:id="refundToRfidCheck" text="Retour carte RFID"/>
        <TextField fx:id="refundReasonField" promptText="Motif (optionnel)"/>
        <HBox spacing="8">
            <Button text="%cancel" styleClass="button elevated" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="52"
                    onAction="#onRefundCancel"/>
            <Button text="✓ %confirm" styleClass="button success" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="52"
                    onAction="#onRefundConfirm"/>
        </HBox>
    </VBox>

    <VBox fx:id="refundPinDialog" visible="false" managed="false" prefWidth="360" spacing="10" styleClass="popup-card"
          StackPane.alignment="CENTER">
        <Label text="PIN manager requis" styleClass="title-4" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
        <TextField fx:id="refundPinInput" promptText="PIN manager"/>
        <HBox spacing="8">
            <Button text="%cancel" styleClass="button elevated" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="48"
                    onAction="#onRefundPinCancel"/>
            <Button text="✓ %confirm" styleClass="button success" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="48"
                    onAction="#onRefundPinConfirm"/>
        </HBox>
    </VBox>

    <VBox fx:id="toastContainer" spacing="6" alignment="BOTTOM_RIGHT" mouseTransparent="true"
          style="-fx-padding: 0 12px 40px 0;" StackPane.alignment="BOTTOM_RIGHT"/>
</StackPane>