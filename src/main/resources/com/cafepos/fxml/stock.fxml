<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootStack" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.cafepos.controllers.StockController">
    <VBox spacing="0">
        <HBox fx:id="toolbar" alignment="CENTER_LEFT" spacing="8">
            <padding>
                <Insets top="8" right="12" bottom="8" left="12"/>
            </padding>
            <TextField fx:id="searchField" promptText="Rechercher… F7" HBox.hgrow="ALWAYS"/>
            <Button fx:id="newProductButton" text="+ Nouveau" onAction="#onNewProduct" styleClass="action-button"/>
        </HBox>

        <TabPane fx:id="tabPane" VBox.vgrow="ALWAYS">
            <tabs>
                <Tab text="Produits" closable="false">
                    <content>
                        <TableView fx:id="productsTable" fixedCellSize="52" VBox.vgrow="ALWAYS" editable="true">
                            <columns>
                                <TableColumn fx:id="activeColumn" text="" prefWidth="40"/>
                                <TableColumn fx:id="nameColumn" text="Nom" prefWidth="200"/>
                                <TableColumn fx:id="categoryColumn" text="Catégorie" prefWidth="140"/>
                                <TableColumn fx:id="preparedColumn" text="Préparé" prefWidth="90"/>
                                <TableColumn fx:id="priceColumn" text="Prix" prefWidth="100"/>
                                <TableColumn fx:id="costColumn" text="Coût" prefWidth="100"/>
                                <TableColumn fx:id="stockColumn" text="Stock" prefWidth="160"/>
                            </columns>
                        </TableView>
                    </content>
                </Tab>
                <Tab text="Ingredients" closable="false">
                    <content>
                        <VBox spacing="10">
                            <padding>
                                <Insets top="12" right="12" bottom="12" left="12"/>
                            </padding>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Button fx:id="newIngredientButton" text="+ Ingredient" onAction="#onNewIngredient" styleClass="action-button"/>
                                <Button fx:id="purchaseIngredientButton" text="Achat / Reappro" onAction="#onPurchaseIngredient" styleClass="ghost-button"/>
                                <Button fx:id="withdrawShoppingButton" text="Sortie caisse shopping" onAction="#onWithdrawShoppingCash" styleClass="ghost-button"/>
                                <Button fx:id="editIngredientButton" text="Editer" onAction="#onEditIngredient" styleClass="ghost-button"/>
                                <Button fx:id="deleteIngredientButton" text="Supprimer" onAction="#onDeleteIngredient" styleClass="ghost-button"/>
                                <Button fx:id="activateIngredientButton" text="Activer" onAction="#onActivateIngredient" styleClass="ghost-button"/>
                                <Button fx:id="deactivateIngredientButton" text="Desactiver" onAction="#onDeactivateIngredient" styleClass="ghost-button"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Unites: KG, G, MG, L, CL, ML, UNIT, PIECE, PACK" styleClass="hint-label"/>
                            </HBox>
                            <TableView fx:id="ingredientsTable" editable="true" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="ingredientActiveColumn" text="On" prefWidth="46"/>
                                    <TableColumn fx:id="ingredientNameColumn" text="Ingredient" prefWidth="180"/>
                                    <TableColumn fx:id="ingredientUnitColumn" text="Unite" prefWidth="90"/>
                                    <TableColumn fx:id="ingredientStockColumn" text="Stock" prefWidth="90"/>
                                    <TableColumn fx:id="ingredientMinColumn" text="Seuil" prefWidth="90"/>
                                    <TableColumn fx:id="ingredientPackageSizeColumn" text="Taille pack" prefWidth="100"/>
                                    <TableColumn fx:id="ingredientPackagePriceColumn" text="Prix pack" prefWidth="100"/>
                                    <TableColumn fx:id="ingredientUnitCostColumn" text="Cout unite" prefWidth="100"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </content>
                </Tab>
                <Tab text="Recettes" closable="false">
                    <content>
                        <VBox spacing="10">
                            <padding>
                                <Insets top="12" right="12" bottom="12" left="12"/>
                            </padding>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="Produit:"/>
                                <ComboBox fx:id="recipeProductCombo" prefWidth="280" onAction="#onRecipeProductChanged"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="recipeEstimatedCostLabel" text="Cout recette: 0 DZD" styleClass="hint-label"/>
                            </HBox>
                            <TableView fx:id="recipeTable" editable="true" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="recipeIngredientColumn" text="Ingredient" prefWidth="220"/>
                                    <TableColumn fx:id="recipeUnitColumn" text="Unite" prefWidth="80"/>
                                    <TableColumn fx:id="recipeQuantityColumn" text="Qte / boisson" prefWidth="120"/>
                                    <TableColumn fx:id="recipeUnitCostColumn" text="Cout unite" prefWidth="110"/>
                                    <TableColumn fx:id="recipeLineCostColumn" text="Cout ligne" prefWidth="110"/>
                                </columns>
                            </TableView>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <ComboBox fx:id="recipeIngredientCombo" prefWidth="260" promptText="Ingredient"/>
                                <TextField fx:id="recipeQuantityField" prefWidth="140" promptText="Quantite"/>
                                <Button text="Ajouter / MAJ" styleClass="action-button" onAction="#onAddRecipeLine"/>
                                <Button text="Supprimer" styleClass="ghost-button" onAction="#onRemoveRecipeLine"/>
                            </HBox>
                        </VBox>
                    </content>
                </Tab>
                <Tab text="Suppléments" closable="false">
                    <content>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="card-scroll">
                            <content>
                                <VBox fx:id="supplementsBox" spacing="12">
                                    <padding>
                                        <Insets top="12" right="12" bottom="12" left="12"/>
                                    </padding>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>
                <Tab text="Catégories" closable="false">
                    <content>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="card-scroll">
                            <content>
                                <VBox fx:id="categoriesBox" spacing="8">
                                    <padding>
                                        <Insets top="12" right="12" bottom="12" left="12"/>
                                    </padding>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </VBox>

        <VBox fx:id="toastContainer" spacing="8" mouseTransparent="true" pickOnBounds="false"
            StackPane.alignment="BOTTOM_RIGHT">
        <StackPane.margin>
            <Insets top="0" right="12" bottom="12" left="0"/>
        </StackPane.margin>
    </VBox>
</StackPane>
